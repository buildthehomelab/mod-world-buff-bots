[worldserver]

#
# WorldBuffBots.Enable
#   Enable the module.
#   Default: 1
#
WorldBuffBots.Enable = 1

#
# WorldBuffBots.Debug
#   Print extra module log lines.
#   Default: 0
#
WorldBuffBots.Debug = 0

#
# WorldBuffBots.MinMinutes / WorldBuffBots.MaxMinutes
#   All buffs share one cycle. When a cycle finishes, the next one is rolled at
#   random between these two values, inclusive, measured between consecutive
#   city turn-ins. Every cycle is rolled fresh, so the gap is never predictable.
#   Set both to the same value for a fixed cycle.
#   Keep MinMinutes above the largest OffsetMinutes below, or the shortest
#   cycles get clamped and the module logs a warning on startup.
#   Default: 30 to 150 minutes.
#
WorldBuffBots.MinMinutes = 30
WorldBuffBots.MaxMinutes = 150

#
#   Deprecated: BaseMinutes and VarianceMinutes. If those are still present and
#   MinMinutes/MaxMinutes are not, they are read as Base-Variance to
#   Base+Variance so an existing realm keeps its timing, and a warning is
#   logged. Replace them with the two settings above.
#

#
# WorldBuffBots.InitialMinMinutes / WorldBuffBots.InitialMaxMinutes
#   Timers are not persistent. The first cycle starts with a random delay in
#   this range after worldserver starts or after a config reload. Separate from
#   MinMinutes/MaxMinutes so you can stagger the first cycle differently.
#   Default: 30 to 150 minutes.
#
WorldBuffBots.InitialMinMinutes = 30
WorldBuffBots.InitialMaxMinutes = 150

#
# WorldBuffBots.WarningMinutes
#   How long before a buff fires the heads-up announcement goes out, so players
#   have time to travel and catch it. The warning states the realm clock time
#   the buff will drop, names the same announcer the final announcement will
#   name, and goes only to the faction that can receive the buff.
#   Set to 0 to disable warnings.
#   If a rerolled timer lands shorter than this, the warning fires on the next
#   world update and reports the time actually remaining.
#   Default: 10
#
WorldBuffBots.WarningMinutes = 10

#
# WorldBuffBots.RestrictBuffToFaction
#   Apply each faction's buff only to players of that faction. With this off,
#   anyone in the target area is buffed, but the announcements stay faction
#   specific. Spirit of Zandalar is always available to both factions.
#   Default: 1
#
WorldBuffBots.RestrictBuffToFaction = 1

#
# WorldBuffBots.<Buff>.OffsetMinutes
#   How long after the city turn-in this buff fires, within the same cycle.
#   Warchief's Blessing and Rallying Cry of the Dragonslayer are both 0, so the
#   Horde and Alliance buffs always land at the same moment. Spirit of Zandalar
#   defaults to 10, giving players who caught a city buff time to travel down to
#   Zul'Gurub for it.
#   The next cycle is measured from the city turn-in, so a longer offset delays
#   Spirit of Zandalar without stretching the gap between cycles.
#

#
# WorldBuffBots.TimeFormat
#   strftime format used for {time} in warnings. Realm time is the worldserver's
#   local time, which is what the in-game clock shows players.
#   Default: %H:%M  (24 hour, e.g. 20:35)
#   For a 12 hour clock use: %I:%M %p  (e.g. 08:35 PM)
#
WorldBuffBots.TimeFormat = %H:%M

#
# Announcement and warning placeholders
#   {player}   the randomly generated announcer name
#   {buff}     the buff name, e.g. Warchief's Blessing
#   {time}     realm clock time the buff drops, e.g. 20:35 (warnings only)
#   {duration} time remaining, e.g. "10 minutes" (warnings only)
#   {minutes}  time remaining as a bare number (warnings only)
#
#   Set a warning to an empty value to suppress it for that buff only.
#

#
# Warchief's Blessing
#   Chooses a random Horde-style name for the announcement.
#   Announced to Horde players only, at the same moment as Rallying Cry.
#   Applies spell 16609 to eligible players in Orgrimmar.
#   IncludeCrossroads also applies the buff to eligible players in the Crossroads
#   10 seconds later, matching AzerothCore's existing Thrall reward script.
#
WorldBuffBots.Warchief.Enable = 1
WorldBuffBots.Warchief.IncludeCrossroads = 1
WorldBuffBots.Warchief.Warning = {player} is carrying Rend Blackhand's head to Orgrimmar. Warchief's Blessing drops at {time} realm time!
WorldBuffBots.Warchief.Announcement = Rend Blackhand has fallen! Thrall has granted Warchief's Blessing in honor of {player}.

#
# Rallying Cry of the Dragonslayer
#   Chooses a random Alliance-style name for the announcement.
#   Announced to Alliance players only, at the same moment as Warchief's Blessing.
#   Applies spell 22888 to eligible players in Stormwind.
#
WorldBuffBots.Dragonslayer.Enable = 1
WorldBuffBots.Dragonslayer.Warning = {player} is carrying the head of Onyxia to Stormwind. Rallying Cry of the Dragonslayer drops at {time} realm time!
WorldBuffBots.Dragonslayer.Announcement = {player} has returned the head of Onyxia! Rallying Cry of the Dragonslayer echoes through Stormwind.

#
# Spirit of Zandalar
#   Chooses a random name from either faction's name pool.
#   Announced to both factions.
#   Fires OffsetMinutes after the city turn-ins, so with the default 10 minute
#   warning the heads-up goes out just as the city buffs land, telling players
#   the realm time to be at Zul'Gurub by.
#   Applies spell 24425 to eligible players in Stranglethorn Vale.
#
WorldBuffBots.Zandalar.Enable = 1
WorldBuffBots.Zandalar.OffsetMinutes = 10
WorldBuffBots.Zandalar.Warning = {player} is carrying the Heart of Hakkar to Yojamba Isle. Spirit of Zandalar drops at {time} realm time!
WorldBuffBots.Zandalar.Announcement = {player} has returned the Heart of Hakkar! Spirit of Zandalar fills Stranglethorn Vale.
